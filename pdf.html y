<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>PDF Araçları - Pratik Araçlar</title>
<style>
:root {
  --blue: #2459d3;
  --bg: #f2f5f9;
  --card: #fff;
  --text: #202938;
  --muted: #637083;
  --line: #dce3ed;
}
* { box-sizing: border-box; }
body {
  margin: 0; padding: 16px;
  background: var(--bg); color: var(--text);
  font-family: Arial, sans-serif; line-height: 1.5;
}
header, main, footer { max-width: 850px; margin: auto; }
header { text-align: center; padding: 15px 0; }
header p, .hint { color: var(--muted); }
a { color: var(--blue); }
.card {
  background: var(--card); padding: 18px;
  margin: 16px 0; border: 1px solid var(--line);
  border-radius: 14px;
  box-shadow: 0 4px 15px #1720330a;
}
h2 { margin-top: 0; font-size: 20px; }
label { display: block; font-weight: 600; margin-top: 12px; }
input[type="file"], input[type="text"] {
  display: block; width: 100%; padding: 11px;
  margin: 8px 0 14px; border: 1px solid #cbd5e1;
  border-radius: 8px; background: #fff; font: inherit;
}
button {
  padding: 11px 15px; border: 0; border-radius: 8px;
  background: var(--blue); color: white;
  font: inherit; font-weight: 600; cursor: pointer;
}
button:disabled { opacity: .55; cursor: wait; }
.result {
  margin-top: 12px; padding: 12px;
  background: #eef3ff; border-radius: 8px;
  overflow-wrap: anywhere;
}
.hint { font-size: 13px; }
#images a { display: inline-block; margin: 8px; }
#images img { display: block; max-width: 130px; border: 1px solid var(--line); }
footer { text-align: center; padding: 20px; color: var(--muted); font-size: 13px; }
</style>
</head>
<body>
<header>
  <h1>📄 PDF Araçları</h1>
  <p>PDF dosyalarını ücretsiz olarak tarayıcında işle.</p>
  <a href="./index.html">← Ana sayfaya dön</a>
</header>

<main>
  <section class="card">
    <h2>📚 PDF Birleştirme</h2>
    <label for="mergeFiles">Birleştirilecek PDF dosyaları</label>
    <input id="mergeFiles" type="file" accept="application/pdf,.pdf" multiple>
    <button id="mergeBtn">PDF'leri Birleştir</button>
    <div id="mergeResult" class="result" aria-live="polite">Henüz dosya seçilmedi.</div>
  </section>

  <section class="card">
    <h2>✂️ PDF Sayfalarını Ayırma</h2>
    <label for="splitFile">PDF dosyası</label>
    <input id="splitFile" type="file" accept="application/pdf,.pdf">
    <label for="pages">İstediğin sayfalar</label>
    <input id="pages" type="text" placeholder="Örnek: 1-3,5,8">
    <p class="hint">Sayfa numaralarını virgülle ayır. Aralık da yazabilirsin: 1-3,5.</p>
    <button id="splitBtn">Seçilen Sayfaları İndir</button>
    <div id="splitResult" class="result" aria-live="polite">Sonuç burada görünecek.</div>
  </section>

  <section class="card">
    <h2>🖼️ PDF Sayfalarını Görsele Dönüştürme</h2>
    <label for="imageFile">PDF dosyası</label>
    <input id="imageFile" type="file" accept="application/pdf,.pdf">
    <button id="imageBtn">Sayfaları PNG'ye Dönüştür</button>
    <div id="imageResult" class="result" aria-live="polite">Görseller burada görünecek.</div>
    <div id="images"></div>
  </section>

  <section class="card">
    <h2>🗜️ PDF Boyutunu Azaltmayı Dene</h2>
    <label for="compressFile">PDF dosyası</label>
    <input id="compressFile" type="file" accept="application/pdf,.pdf">
    <button id="compressBtn">PDF'yi Optimize Et</button>
    <div id="compressResult" class="result" aria-live="polite">
      Bu işlem her PDF'yi küçültmeyebilir.
    </div>
    <p class="hint">
      Bu temel optimizasyon, gelişmiş resim sıkıştırması değildir.
      Sonuç dosyası bazen aynı boyutta veya daha büyük olabilir.
    </p>
  </section>

  <p class="hint">
    Dosyalar bu sayfanın JavaScript koduyla tarayıcıda işlenir.
    PDF'lerin hiçbir zaman cihazından çıkmadığını garanti etmek için
    çevrimdışı kullanabilir veya ağ bağlantısını kapatıp test edebilirsin.
    Harici kütüphaneler ilk açılışta internetten yüklenir.
  </p>
</main>

<footer>Pratik Araçlar · PDF Araçları</footer>

<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script>
"use strict";

const $ = id => document.getElementById(id);
const { PDFDocument } = PDFLib;

pdfjsLib.GlobalWorkerOptions.workerSrc =
  "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";

function setMessage(id, message) {
  $(id).textContent = message;
}

function readFile(file) {
  if (!file) throw new Error("Lütfen bir PDF dosyası seç.");
  if (file.type !== "application/pdf" &&
      !file.name.toLowerCase().endsWith(".pdf")) {
    throw new Error("Lütfen geçerli bir PDF dosyası seç.");
  }
  return file.arrayBuffer();
}

function downloadBlob(blob, filename) {
  const url = URL.createObjectURL(blob);
  const link = document.createElement("a");
  link.href = url;
  link.download = filename;
  document.body.appendChild(link);
  link.click();
  link.remove();
  setTimeout(() => URL.revokeObjectURL(url), 60000);
}

function downloadPdf(bytes, filename) {
  const blob = new Blob([bytes], { type: "application/pdf" });
  downloadBlob(blob, filename);
}

function safeName(name) {
  return name.replace(/\.pdf$/i, "").replace(/[^\w\-ğüşöçıİĞÜŞÖÇ]/gi, "_");
}

async function runButton(buttonId, resultId, task) {
  const button = $(buttonId);
  button.disabled = true;
  try {
    await task();
  } catch (error) {
    console.error(error);
    setMessage(resultId, "İşlem başarısız: " +
      (error && error.message ? error.message :
       "Dosya okunamadı. PDF şifreli veya bozuk olabilir."));
  } finally {
    button.disabled = false;
  }
}

// PDF BİRLEŞTİRME
$("mergeBtn").addEventListener("click", () =>
  runButton("mergeBtn", "mergeResult", async () => {
    const files = Array.from($("mergeFiles").files);
    if (files.length < 2) {
      throw new Error("En az iki PDF dosyası seç.");
    }

    const merged = await PDFDocument.create();

    for (const file of files) {
      const source = await PDFDocument.load(await readFile(file));
      const copiedPages = await merged.copyPages(
        source, source.getPageIndices()
      );
      copiedPages.forEach(page => merged.addPage(page));
    }

    const bytes = await merged.save();
    downloadPdf(bytes, "birlesik-pdf.pdf");
    setMessage("mergeResult",
      "Birleştirme tamamlandı. İndirme başlatıldı.");
  })
);

// SAYFA AYIRMA
$("splitBtn").addEventListener("click", () =>
  runButton("splitBtn", "splitResult", async () => {
    const file = $("splitFile").files[0];
    const source = await PDFDocument.load(await readFile(file));
    const total = source.getPageCount();
    const input = $("pages").value.trim();

    if (!input) throw new Error("Sayfa numaralarını yaz. Örnek: 1-3,5");

    const selected = new Set();

    for (const part of input.split(",")) {
      const value = part.trim();
      const range = value.match(/^(\d+)\s*-\s*(\d+)$/);

      if (range) {
        const start = Number(range[1]);
        const end = Number(range[2]);
        if (start < 1 || end < start || end > total) {
          throw new Error("Sayfa aralığı geçersiz. Bu PDF " + total + " sayfa.");
        }
        for (let n = start; n <= end; n++) selected.add(n - 1);
      } else if (/^\d+$/.test(value)) {
        const n = Number(value);
        if (n < 1 || n > total) {
          throw new Error("Sayfa numarası 1 ile " + total + " arasında olmalı.");
        }
        selected.add(n - 1);
      } else {
        throw new Error("Sayfa biçimi geçersiz. Örnek: 1-3,5");
      }
    }

    const indices = Array.from(selected).sort((a, b) => a - b);
    const output = await PDFDocument.create();
    const copied = await output.copyPages(source, indices);
    copied.forEach(page => output.addPage(page));

    downloadPdf(await output.save(), safeName(file.name) + "-sayfalar.pdf");
    setMessage("splitResult",
      indices.length + " sayfa yeni PDF dosyasına aktarıldı.");
  })
);

// PDF SAYFALARINI PNG'YE DÖNÜŞTÜRME
$("imageBtn").addEventListener("click", () =>
  runButton("imageBtn", "imageResult", async () => {
    const file = $("imageFile").files[0];
    const data = new Uint8Array(await readFile(file));
    const pdf = await pdfjsLib.getDocument({ data }).promise;
    const container = $("images");
    container.replaceChildren();

    setMessage("imageResult", pdf.numPages + " sayfa işleniyor...");

    for (let pageNo = 1; pageNo <= pdf.numPages; pageNo++) {
      const page = await pdf.getPage(pageNo);
      const viewport = page.getViewport({ scale: 1.5 });
      const canvas = document.createElement("canvas");
      const context = canvas.getContext("2d");

      canvas.width = Math.floor(viewport.width);
      canvas.height = Math.floor(viewport.height);

      await page.render({ canvasContext: context, viewport }).promise;

      const blob = await new Promise(resolve =>
        canvas.toBlob(resolve, "image/png")
      );
      if (!blob) throw new Error("PNG görseli oluşturulamadı.");

      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.download = safeName(file.name) + "-sayfa-" + pageNo + ".png";

      const image = document.createElement("img");
      image.src = url;
      image.alt = "PDF sayfa " + pageNo;
      image.loading = "lazy";

      link.appendChild(image);
      link.appendChild(document.createTextNode(
        "Sayfa " + pageNo + " PNG indir"
      ));
      container.appendChild(link);
    }

    setMessage("imageResult",
      "Dönüştürme tamamlandı. İstediğin sayfanın görseline dokun.");
  })
);

// TEMEL PDF OPTİMİZASYONU
$("compressBtn").addEventListener("click", () =>
  runButton("compressBtn", "compressResult", async () => {
    const file = $("compressFile").files[0];
    const sourceBytes = await readFile(file);
    const source = await PDFDocument.load(sourceBytes);
    const outputBytes = await source.save({ useObjectStreams: true });

    downloadPdf(outputBytes, safeName(file.name) + "-optimize.pdf");

    const before = sourceBytes.byteLength;
    const after = outputBytes.byteLength;
    const percent = before ? Math.round((before - after) / before * 100) : 0;

    setMessage("compressResult",
      "Önce: " + (before / 1024).toFixed(1) + " KB. " +
      "Sonra: " + (after / 1024).toFixed(1) + " KB. " +
      (percent > 0
        ? "%" + percent + " daha küçük."
        : "Dosya küçülmedi; bu yöntem her PDF'yi sıkıştıramaz."));
  })
);
</script>
</body>
</html>
